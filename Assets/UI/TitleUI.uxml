<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(28, 18, 12, 0.72); justify-content: center; align-items: center;">
        <ui:VisualElement style="align-items: center; padding-top: 18px; padding-bottom: 56px; padding-left: 72px; padding-right: 72px; background-color: rgba(255, 244, 220, 0.08); border-top-left-radius: 28px; border-top-right-radius: 28px; border-bottom-left-radius: 28px; border-bottom-right-radius: 28px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(255, 200, 120, 0.35); border-right-color: rgba(255, 200, 120, 0.35); border-top-color: rgba(255, 200, 120, 0.35); border-bottom-color: rgba(255, 200, 120, 0.35);">
            <ui:Label text="FRUIT" name="GameTitel" style="font-size: 42px; -unity-font-style: bold; color: rgb(255, 232, 158); letter-spacing: 10px; text-shadow: 5px 7px 0 rgb(170, 58, 22); margin-bottom: -22px; top: 0; position: relative; right: 0; left: 0; bottom: 0; margin-top: 0; padding-top: 0;"/>
            <ui:Label text="STEALER" style="font-size: 48px; -unity-font-style: bold; color: rgb(255, 118, 64); letter-spacing: 10px; text-shadow: 5px 7px 0 rgb(110, 28, 8);"/>
            <ui:Label text="catch the runaway fruit" style="font-size: 14px; color: rgba(255, 232, 200, 0.65); margin-top: 12px; letter-spacing: 6px;"/>
            <ui:Button text="START" name="StartButton" style="margin-top: 24px; padding-left: 80px; padding-right: 80px; padding-top: 18px; padding-bottom: 18px; background-color: rgb(255, 183, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 5px; border-left-width: 0; border-bottom-color: rgb(180, 100, 0); border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-left-radius: 100px; border-bottom-right-radius: 100px; color: rgb(80, 32, 0); font-size: 22px; -unity-font-style: bold; letter-spacing: 8px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
